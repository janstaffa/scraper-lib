{
  "name": "@janstaffa/scraper-lib",
  "version": "1.0.5",
  "description": "Node.js web scraper library and utility.",
  "main": "./dist/scraper.js",
  "types": "./dist/scraper.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janstaffa/scraper-lib.git"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "gentype": "npx ts-interface-builder src/types/scraper.ts",
    "build": "npm run gentype && tsc"
  },
  "exports": {
    ".": {
      "types": "./dist/scraper.d.ts",
      "import": "./dist/scraper.js"
    },
    "./ti": {
      "types": "./dist/types/scraper-ti.d.ts",
      "import": "./dist/types/scraper-ti.js"
    }
  },
  "keywords": [
    "scraper",
    "webscraper",
    "utility",
    "node.js"
  ],
  "author": "janstaffa",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/command-line-args": "^5.2.3",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "ts-interface-builder": "^0.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "command-line-args": "^6.0.2",
    "dotenv": "^17.4.1",
    "puppeteer": "^24.40.0",
    "ts-interface-checker": "^1.0.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "puppeteer@24.40.0": true
  }
}